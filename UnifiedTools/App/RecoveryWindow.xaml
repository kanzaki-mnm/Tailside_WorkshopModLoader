<Window x:Class="UnifiedTools.RecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:UnifiedTools" Title="Tailside Mod Environment Setup &amp; Recovery" Width="620" Height="440" MinWidth="520" MinHeight="400" Background="#F5F0E9" Foreground="#382B27" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><ComboBox x:Name="LanguageChoice" DockPanel.Dock="Right" MinWidth="120" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="LanguageChanged" AutomationProperties.Name="Language / 言語"/><TextBlock x:Name="PageTitle" FontSize="18" FontWeight="SemiBold"/></DockPanel>
  <DockPanel Grid.Row="1" Margin="0,12,0,18"><Button x:Name="Browse" DockPanel.Dock="Right" Margin="10,0,0,0" Click="BrowseClicked"/><TextBlock x:Name="Location" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" FontSize="11" Foreground="#75685F" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></DockPanel>
  <ScrollViewer x:Name="BodyScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:StatusSymbol x:Name="StatusIcon" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,3,0,0" Stroke="{Binding Foreground,ElementName=StatusHeading}" VerticalAlignment="Top" IsHitTestVisible="False" Focusable="False"/><StackPanel Grid.Column="1"><TextBlock x:Name="StatusHeading" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Margin="0,7,0,0" Foreground="#75685F"/></StackPanel></Grid>
   <Button Width="280" HorizontalAlignment="Left" x:Name="Primary" Click="PrimaryClicked" Margin="0,18,0,0" MinHeight="42" FontSize="14" FontWeight="SemiBold" Background="#73563F" Foreground="White"/>
   <StackPanel Width="280" HorizontalAlignment="Left" x:Name="OwnedActions" Margin="0,12,0,0"><Button x:Name="Pause" Click="PauseClicked" MinHeight="40" Margin="0,0,0,8"/><Button x:Name="Remove" Click="RemoveClicked" MinHeight="40"/></StackPanel>
   <TextBlock x:Name="UsageHint" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="70"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=LastResult}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><TextBlock x:Name="LastResult" Margin="0,10,0,0"/></ScrollViewer>
   <Expander x:Name="DetailsPanel" Margin="0,16,0,0" IsExpanded="False"><StackPanel Margin="0,10,0,0">
    <WrapPanel x:Name="RecoveryActions"><Button x:Name="Repair" Click="RepairClicked" Margin="0,0,8,8"/><Button x:Name="KeepTool" Click="KeepToolClicked" Margin="0,0,8,8"/></WrapPanel>
    <WrapPanel><Button x:Name="Folder" Click="FolderClicked" Margin="0,0,8,8"/><Button x:Name="Report" Click="ReportClicked" Margin="0,0,8,8"/></WrapPanel>
    <Border x:Name="ManualPanel" Background="#EEE5DA" CornerRadius="9" Padding="12" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ManualHeading" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ManualInstructions" Margin="0,8,0,0"/></StackPanel></Border>
    <TextBlock x:Name="SourceText" FontSize="11" Foreground="#75685F" Margin="0,6,0,4"/>
   </StackPanel></Expander>
   </StackPanel>
  </ScrollViewer>
  <DockPanel Grid.Row="3"><WrapPanel DockPanel.Dock="Right"><Button x:Name="Guide" Click="GuideClicked"/><Button x:Name="Admin" Click="AdminClicked" Visibility="Collapsed" Margin="8,0,0,0"/></WrapPanel><TextBlock x:Name="VersionText" FontSize="10" Foreground="#75685F" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>





